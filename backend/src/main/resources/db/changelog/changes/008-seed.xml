<?xml version="1.0" encoding="UTF-8"?>
<!--
 ============================================================================
 TICKET-ADV017 — Seed data (counterparties, instruments, sample trades, users)
 ============================================================================
-->
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <changeSet id="008-seed-counterparties" author="antigravity" context="!prod">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM counterparties</sqlCheck>
        </preConditions>
        <loadData file="data/counterparties.csv" tableName="counterparties"
                  separator="," relativeToChangelogFile="true">
            <column name="id" type="NUMERIC"/>
            <column name="name" type="STRING"/>
            <column name="lei_code" type="STRING"/>
            <column name="region" type="STRING"/>
        </loadData>
        <rollback>
            <sql>DELETE FROM counterparties;</sql>
        </rollback>
    </changeSet>

    <changeSet id="008-seed-instruments" author="antigravity" context="!prod">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM instruments</sqlCheck>
        </preConditions>
        <loadData file="data/instruments.csv" tableName="instruments"
                  separator="," relativeToChangelogFile="true">
            <column name="id" type="NUMERIC"/>
            <column name="symbol" type="STRING"/>
            <column name="name" type="STRING"/>
            <column name="asset_class" type="STRING"/>
            <column name="currency" type="STRING"/>
            <column name="isin" type="STRING"/>
            <column name="metadata" type="STRING"/>
        </loadData>
        <rollback>
            <sql>DELETE FROM instruments;</sql>
        </rollback>
    </changeSet>

    <changeSet id="008-seed-trades" author="antigravity" context="!prod">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM trades</sqlCheck>
        </preConditions>
        <loadData file="data/trades.csv" tableName="trades"
                  separator="," relativeToChangelogFile="true">
            <column name="id" type="NUMERIC"/>
            <column name="trade_ref" type="STRING"/>
            <column name="instrument_id" type="NUMERIC"/>
            <column name="counterparty_id" type="NUMERIC"/>
            <column name="asset_class" type="STRING"/>
            <column name="side" type="STRING"/>
            <column name="quantity" type="NUMERIC"/>
            <column name="price" type="NUMERIC"/>
            <column name="trade_date" type="DATE"/>
            <column name="status" type="STRING"/>
        </loadData>
        <rollback>
            <sql>DELETE FROM trades;</sql>
        </rollback>
    </changeSet>

    <changeSet id="008-seed-users" author="antigravity" context="!prod">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM users</sqlCheck>
        </preConditions>
        <insert tableName="users">
            <column name="email" value="admin@db.com"/>
